# Copy these into Netlify: Site configuration > Environment variables. NEVER commit a real .env file.
KLAVIYO_ENV=demo
KLAVIYO_API_KEY_DEMO=
KLAVIYO_LIST_ID_DEMO=
# Leave production blank until launch. Real orders are blocked until verified payments exist.
KLAVIYO_API_KEY_PROD=
KLAVIYO_LIST_ID_PROD=
# Your live site address, no trailing slash, e.g. https://crave-hub.netlify.app
ALLOWED_ORIGIN=
SITE_URL=
# Long random text. Only needed while you run the Klaviyo test tool. Delete it afterwards to switch the tool off.
TEST_TOKEN=
